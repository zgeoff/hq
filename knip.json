{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/check/*.ts",
    "src/**/*.test.{ts,tsx}",
    "test/**/*.test.ts",
    "test/run-stub-*.ts",
    "mocks/**/*.test.ts",
    "src/console/main.tsx",
    "mods/hq-band/hooks/register.tsx",
    ".claude/hooks/*/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "mocks/**/*.ts",
    "mods/**/*.{ts,tsx}",
    ".claude/hooks/**/*.ts"
  ],
  "ignoreDependencies": [
    "geist",
    "@stylistic/eslint-plugin",
    "@zgeoff/diet",
    "@zgeoff/rig",
    "claude-code"
  ]
}
