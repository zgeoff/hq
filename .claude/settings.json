{
  "permissions": {
    "allow": [
      "Bash(op-mint --list)",
      "Bash(op-mint hq)",
      "Bash(op-mint imp)",
      "Bash(op-mint nixie)",
      "Bash(op-mint noslop)",
      "Bash(op-mint osrs)",
      "Bash(op-mint pepys)",
      "Bash(op-mint vers)",
      "Bash(op-mint wow-forever)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh 1"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh 2"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh 3"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh 4"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh 5"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh 6"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh briefs"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/print-skills.sh after"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.ts\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-install \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.ts\""
          }
        ]
      }
    ]
  }
}
