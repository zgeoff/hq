{
  "name": "hq",
  "version": "0.98.0",
  "private": true,
  "bin": {
    "hq": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsrs --noEmit",
    "deadcode": "knip",
    "fmt": "oxfmt '**/*.{md,yml,yaml,json}'",
    "fmt:check": "oxfmt --check '**/*.{md,yml,yaml,json}'",
    "check:skills": "bun scripts/check-skills.ts",
    "test:scripts": "sh scripts/test-scripts.sh",
    "install-bin": "sh scripts/install.sh",
    "lint:changed": "bun scripts/lint-changed.ts",
    "grants": "bun scripts/grants.ts",
    "check:grants": "bun scripts/grants.ts --check",
    "check:skill-writing": "sh scripts/check-skill-writing.sh"
  },
  "dependencies": {
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/standard-server-peer": "1.16.1",
    "@orpc/tanstack-query": "1.16.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@zgeoff/std": "0.3.1",
    "geist": "1.8.2",
    "kysely": "0.29.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@zgeoff/oxlint-config": "0.7.5",
    "@zgeoff/skill-gate": "0.2.13",
    "knip": "6.43.0",
    "msw": "2.15.0",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2"
  }
}
