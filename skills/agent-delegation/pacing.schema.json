{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pacing.json",
  "description": "Delivery's launch limits, read by capacity.sh and hq. scripts/check-pacing.sh checks pacing.json against this schema, and that every route names a known provider.",
  "type": "object",
  "required": ["designSlots", "lanes", "imp", "providers", "routes"],
  "additionalProperties": false,
  "properties": {
    "designSlots": {
      "type": "integer",
      "minimum": 0
    },
    "lanes": {
      "type": "object",
      "required": ["imp", "local"],
      "additionalProperties": false,
      "properties": {
        "imp": {
          "$ref": "#/$defs/laneSizes"
        },
        "local": {
          "$ref": "#/$defs/laneSizes"
        }
      }
    },
    "lends": {
      "type": "object",
      "description": "Lanes that neither lend their free slots nor borrow another's, mapped to false. A lane left out lends and borrows.",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "imp": {
      "type": "object",
      "required": ["impMib"],
      "additionalProperties": false,
      "properties": {
        "impMib": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "routes": {
      "type": "object",
      "required": ["S", "M", "L", "XL"],
      "additionalProperties": false,
      "properties": {
        "S": {
          "$ref": "#/$defs/route"
        },
        "M": {
          "$ref": "#/$defs/route"
        },
        "L": {
          "$ref": "#/$defs/route"
        },
        "XL": {
          "$ref": "#/$defs/route"
        }
      }
    }
  },
  "$defs": {
    "laneSizes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "provider": {
      "type": "object",
      "required": ["agent", "threshold", "unattended", "target"],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "unattended": {
          "type": "boolean"
        },
        "target": {
          "enum": ["imp", "local"]
        },
        "localFallback": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
