{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    ".claude/hooks/start.ts",
    "src",
    "test",
    "mocks",
    "scripts/grants.ts",
    "scripts/grants.test.ts",
    "scripts/lint-changed.ts",
    "scripts/lint-changed.test.ts",
    "scripts/check",
    "skills/pr-review/scripts/rename-decls.ts"
  ]
}
